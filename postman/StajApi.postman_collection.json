{
  "info": {
    "_postman_id": "5c23c4fb-f49c-4bd1-832d-5ea205aad975",
    "name": "StajApi - User ve JWT İşlemleri",
    "description": "User CRUD, geçersiz GUID, login ve JWT doğrulama için hazır istekler.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5039"
    },
    {
      "key": "userId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "userEmail",
      "value": "kaan.kesen@pointr.tech"
    },
    {
      "key": "userPassword",
      "value": "Password123!"
    },
    {
      "key": "jwtToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - User List (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/User",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "User"
          ]
        }
      }
    },
    {
      "name": "2 - User Tekil Get (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/User/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "User",
            "{{userId}}"
          ]
        }
      }
    },
    {
      "name": "3 - Geçersiz GUID Hatası (GET 400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/User/gecersiz-guid",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "User",
            "gecersiz-guid"
          ]
        }
      }
    },
    {
      "name": "4 - User Create (POST)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('userEmail', `postman.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set('userId', response.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/User",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "User"
          ]
        }
      }
    },
    {
      "name": "5 - User Update Name (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User Updated\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/User/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "User",
            "{{userId}}"
          ]
        }
      }
    },
    {
      "name": "6 - Login ve JWT Al (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set('jwtToken', response.accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/Auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "7 - JWT Validate ve Claimleri Getir (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Auth/validate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Auth",
            "validate"
          ]
        }
      }
    },
    {
      "name": "8 - User Delete (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/User/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "User",
            "{{userId}}"
          ]
        }
      }
    }
  ]
}
